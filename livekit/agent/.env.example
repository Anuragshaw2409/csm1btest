LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Local model config
AGENT_NAME=csm-local-agent
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434/v1
WHISPER_MODEL_SIZE=base.en
CSM_SPEAKER=conversational_a

# Remote CSM TTS (server/tts_server.py on a separate GPU box). Leave unset to
# keep running CSM in-process (local mode, csm_tts.py).
# CSM_TTS_SERVER_URL=wss://<gpu-host>:8000/v1/tts/stream
# CSM_TTS_SERVER_INSECURE_TLS=1  # only if using the repo's self-signed .certs/
